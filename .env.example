# Without DATABASE_URL, uses embedded PostgreSQL in .faultline/data.
# DATABASE_URL=postgresql://faultline:faultline@localhost:5432/faultline
HOST=127.0.0.1
PORT=4310
# Separate workers require server PostgreSQL, not the embedded database.
# FAULTLINE_WORKER=external
# Live evaluation is CLI-only and also requires --accept-costs.
# OPENAI_API_KEY=
# OPENAI_MODEL=
