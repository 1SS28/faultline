{
  "name": "faultline-sdk",
  "version": "0.1.0",
  "description": "Inject tool failures into an AI agent's tools, then check what really happened.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "files": ["dist", "LICENSE", "NOTICE", "README.md"],
  "sideEffects": false,
  "engines": { "node": ">=18" },
  "keywords": ["ai", "agents", "testing", "fault-injection", "tool-use", "idempotency"],
